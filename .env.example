# Local development defaults. Copy to .env; never commit real credentials.
NODE_ENV=development
API_PORT=3100
WEB_PORT=5173
VITE_API_URL=http://localhost:${API_PORT}

POSTGRES_DB=sidestage
POSTGRES_USER=sidestage
POSTGRES_PASSWORD=sidestage_dev
DATABASE_URL=postgresql://sidestage:sidestage_dev@127.0.0.1:55434/sidestage

TYPESENSE_API_KEY=dev-typesense-key
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
REDIS_URL=redis://localhost:6379

MEDIAMTX_HOST=localhost
MEDIAMTX_WHIP_URL=http://localhost:8889
MEDIAMTX_WHEP_URL=http://localhost:8889

# Server-only Deepgram project key with Member permissions. The API exchanges
# it for a short-lived browser token; never rename this to a VITE_* variable.
# Leave blank in local development to use the browser Web Speech fallback.
DEEPGRAM_API_KEY=

# Mobile app store links for the site's download buttons (footer). Leave blank
# until the apps are published; blank renders the buttons as "Coming soon".
VITE_IOS_APP_URL=
VITE_ANDROID_APP_URL=

# Optional live build-history source. These values are consumed by the API only;
# the browser receives the bounded, read-only aggregate through @papercusp/sync.
PAPERCUSP_OPERATOR_URL=http://127.0.0.1:3070
PAPERCUSP_OPERATOR_WORKSPACE=papercusp-workspace
PAPERCUSP_OPERATOR_HARNESS=papercusp
PAPERCUSP_BUILD_HISTORY_PREFIX=sidestage-

# Server-only shipping calculator credentials. Leave blank in local development
# to return an empty rate list; production values live in .env.production.
EASYPOST_API_KEY=
WAREHOUSE_FROM_NAME=SideStage
WAREHOUSE_FROM_STREET1=
WAREHOUSE_FROM_CITY=
WAREHOUSE_FROM_STATE=
WAREHOUSE_FROM_ZIP=
WAREHOUSE_FROM_COUNTRY=US

# Server-only Square sandbox configuration. Never expose access/signature keys
# through a VITE_* variable; checkout returns only the public app/location ids.
SQUARE_APP_ID=
SQUARE_LOCATION_ID=
SQUARE_ACCESS_TOKEN=

# Auction write boundary. Development may use these placeholders; production
# must inject independent high-entropy values and never bundle them into Vite.
SIDESTAGE_AUCTION_SELLER_TOKEN=sidestage-local-seller-token
SIDESTAGE_AUCTION_SIGNING_SECRET=sidestage-local-auction-signing-secret-change-me
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_NOTIFICATION_URL=
