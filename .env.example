# Local development defaults. Copy to .env; never commit real credentials.
NODE_ENV=development
API_PORT=3110
WEB_PORT=5173
VITE_API_URL=http://localhost:${API_PORT}

POSTGRES_DB=sidestage
POSTGRES_USER=sidestage
POSTGRES_PASSWORD=sidestage_dev
DATABASE_URL=postgresql://sidestage:sidestage_dev@127.0.0.1:55434/sidestage

TYPESENSE_API_KEY=dev-typesense-key
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
REDIS_URL=redis://localhost:6379

# Scout, the Copilot, the Judge and the transcript product-focus classifier all
# run Gemini through Vertex and share ONE gate: a blank GOOGLE_CLOUD_PROJECT
# keeps every audited deterministic engine active. Keep the project/location
# external to the repository; no service-account JSON or API key belongs here.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Optional path to a service-account key file. Blank uses Application Default
# Credentials, which is the documented path. Production sets this to a path
# INSIDE the container: docker-compose.prod.yml mounts ./secrets at /secrets:ro,
# so the value is a filename to read, never the credential itself.
GOOGLE_APPLICATION_CREDENTIALS=
# Per-surface model overrides. Blank uses the factory default, shown here only
# for Scout; SIDESTAGE_PRODUCT_FOCUS_VERTEX_MODEL falls back to the Copilot's.
SCOUT_VERTEX_MODEL=gemini-3.1-pro-preview-customtools
SIDESTAGE_COPILOT_VERTEX_MODEL=
SIDESTAGE_JUDGE_VERTEX_MODEL=
SIDESTAGE_PRODUCT_FOCUS_VERTEX_MODEL=

MEDIAMTX_HOST=localhost
MEDIAMTX_WHIP_URL=http://localhost:8889
MEDIAMTX_WHEP_URL=http://localhost:8889

# Server-only Deepgram project key with Member permissions. The API exchanges
# it for a short-lived browser token; never rename this to a VITE_* variable.
# Leave blank in local development to use the browser Web Speech fallback.
DEEPGRAM_API_KEY=

# Optional server-side Copilot model. Leave either the key or model blank to
# use the audited deterministic generator; no provider credential is required.
OPENAI_API_KEY=
OPENAI_BASE_URL=
SIDESTAGE_COPILOT_MODEL=

# Mobile app store links for the site's download buttons (footer). Leave blank
# until the apps are published; blank renders the buttons as "Coming soon".
VITE_IOS_APP_URL=
VITE_ANDROID_APP_URL=

# Optional live build-history source. These values are consumed by the API only;
# the browser receives the bounded, read-only aggregate through @papercusp/sync.
PAPERCUSP_OPERATOR_URL=http://127.0.0.1:3070
PAPERCUSP_OPERATOR_WORKSPACE=papercusp-workspace
PAPERCUSP_OPERATOR_HARNESS=papercusp
PAPERCUSP_BUILD_HISTORY_PREFIX=sidestage-

# Server-only shipping calculator credentials. Leave blank in local development
# to return an empty rate list; production values live in .env.production.
EASYPOST_API_KEY=
WAREHOUSE_FROM_NAME=SideStage
WAREHOUSE_FROM_STREET1=
WAREHOUSE_FROM_CITY=
WAREHOUSE_FROM_STATE=
WAREHOUSE_FROM_ZIP=
WAREHOUSE_FROM_COUNTRY=US

# Stripe checkout configuration. Keep the secret and webhook keys server-only;
# checkout returns the publishable key and PaymentIntent client secret only.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Auction guest-identity signing boundary. Production must inject an
# independent high-entropy value and never bundle it into Vite.
SIDESTAGE_AUCTION_SIGNING_SECRET=sidestage-local-auction-signing-secret-change-me
