{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": "src",
    // Test files here import `@papercusp/test-config`, whose package entry resolves
    // to libs/test-config/src/*.ts — so those sources join THIS program and are
    // compiled under THESE options. They import with explicit `.ts` extensions, so
    // without this flag the whole library reports TS5097 against a config that is
    // otherwise fine. TypeScript only permits the flag when not emitting, which is
    // exactly what this config is for: `typecheck` runs it with --noEmit.
    // The emitting build uses tsconfig.build.json, which excludes tests (and hence
    // libs/test-config) and therefore does not need — and cannot have — this flag.
    "allowImportingTsExtensions": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "noEmit": false,
    "baseUrl": ".",
    // `moduleResolution: "Node"` (node10) predates package `exports` maps, so it
    // cannot see @rocicorp/zero's "./server" / "./server/adapters/*" / "./bindings"
    // subpaths and reports TS2307 for them — even though Node resolves all three
    // fine at runtime (verified: `require('@rocicorp/zero/server')` returns
    // PushProcessor et al; `@rocicorp/zero/bindings` served a live /zero/query).
    // These entries point the TYPE resolver at the same files the exports map
    // names, so source keeps importing the public specifier rather than a deep
    // out/ path. Remove them if this project ever moves to Bundler/NodeNext.
    //
    // ⚠⚠ LEAVE THE TARGETS EXTENSIONLESS. `paths` is NOT type-only: tsx honours
    // tsconfig paths at RUNTIME, so each resolver must land on a different file
    // here, and only the extensionless form lets both win — TS picks `pg.d.ts`,
    // tsx picks `pg.js`. Both wrong forms were measured (2026-08-17, WI-39663):
    //   `…/pg.d.ts` → tsx LOADS THE DECLARATION FILE, whose
    //      `export * from '../../../zero-server/src/adapters/pg.ts'` names a .ts the
    //      package does not ship → MODULE_NOT_FOUND. ZeroController is in
    //      AppModule's graph, so the ENTIRE API fails to boot: `start:dev` retried
    //      forever while bootstrapWithRetry's /healthz still answered 200 — the
    //      port looks up and serves nothing.
    //   `…/pg.js`   → TS7016, no declaration file (TS does not substitute the
    //      sibling .d.ts for a node10 `paths` target).
    // ⚠ Neither `tsc --noEmit` NOR the vitest suite can catch a regression here:
    // emit ignores `paths`, and vitest resolves through vite, not tsx. The only
    // check that sees it is booting the API (see the guard test in
    // src/sync/zero-adapter-runtime-resolution.spec.ts).
    "paths": {
      // Stop the type resolver at a local shim instead of opening
      // libs/test-config's sources under THIS project's options (TS5097/TS1343).
      // See src/types/test-config-root.d.ts. Runtime is unaffected: vitest
      // resolves through vite. Durable fix tracked as EI-22383491035147414.
      "@papercusp/test-config": ["src/types/test-config-root.d.ts"],
      "@rocicorp/zero/server": ["../../node_modules/@rocicorp/zero/out/zero/src/server"],
      "@rocicorp/zero/server/adapters/pg": [
        "../../node_modules/@rocicorp/zero/out/zero/src/adapters/pg"
      ],
      // `addContextToQuery` — the only supported way to turn a registry leaf's
      // QueryRequest descriptor into the branded Query `handleQueryRequest`
      // demands (zero.controller.ts:transformQueryAs). Not re-exported from the
      // root entry or from "./server", so this subpath is the public route to it.
      "@rocicorp/zero/bindings": ["../../node_modules/@rocicorp/zero/out/zero/src/bindings"]
    }
  },
  "include": ["src"]
}
