{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    "rootDir": "src",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "noEmit": false,
    "baseUrl": "."
    // ⛔ DO NOT add `paths` entries for @rocicorp/zero's "./server" subpaths.
    // `moduleResolution: "Node"` (node10) predates package `exports` maps, so it
    // cannot see them and reports TS2307 — but `paths` is the WRONG fix, because it
    // is not type-only: tsx honours tsconfig paths at RUNTIME. Mapping to the .d.ts
    // made tsx load the declaration file, whose
    // `export * from '../../../zero-server/src/adapters/pg.ts'` names a .ts that does
    // not ship -> MODULE_NOT_FOUND; ZeroController is in AppModule's graph, so the
    // ENTIRE API failed to boot (`start:dev` retried forever while
    // bootstrapWithRetry's /healthz still answered 200 — up-looking, serving nothing).
    // Mapping to the .js instead fails the other way: TS7016, no declaration file.
    // The type gap is closed by src/types/rocicorp-zero-server.d.ts, which leaves
    // runtime resolution to Node's exports map where it belongs.
    // ⚠ Neither `tsc --noEmit` nor the vitest suite can catch a regression here:
    // emit ignores paths, and vitest resolves through vite rather than tsx.
  },
  "include": ["src"]
}
