{
  "name": "@papercusp/typesense",
  "version": "0.0.1",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": { "types": "./src/index.ts", "import": "./dist/index.js", "require": "./dist/index.js", "default": "./dist/index.js" }
