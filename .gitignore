node_modules/
dist/
coverage/
.env
.env.*
!.env.example
# Real Restart production catalog export — local-only, never committed to the
# public repo (the committed fixture is db/seed/demo.sql; see plan
# sidestage-code-quality-2026-08-13 D-001).
db/seed/restart-catalog.sql
.DS_Store
*.log
apps/*/dist/
apps/*/.vite/
apps/*/.turbo/
# Generated from node_modules/vditor by the web predev/prebuild hook.
apps/web/public/vditor/
# Local zero-cache SQLite replica (scripts/zero-cache-start.sh). This is a full
# copy of the replicated publication — measured 3476 MB on 2026-08-17 — plus its
# WAL. It must never be committed.
.zero/
# Agent console liveness markers (one per running agent console, named by PID).
# Purely local scratch — 17 of these had been committed to the public repo root,
# where they were the first thing a reviewer saw in a clean clone (WI-39713).
# This rule is the recurrence guard: without it they come straight back.
.papercup-console-active.*

# Release-candidate worktrees are local verification sandboxes. If one lives
# below the repository, Git otherwise records it as a mode-160000 gitlink; a
# clean checkout then fails because these worktrees are not project submodules
# and intentionally have no .gitmodules URL.
.papercusp/worktrees/
.papercusp/local-worktrees/
