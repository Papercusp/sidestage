{
  "name": "@papercusp/sidestage",
  "version": "0.1.0",
  "private": true,
  "description": "SideStage live-selling copilot contest submission.",
  "workspaces": [
    "apps/*",
    "libs/*",
    "libs/papergrid/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run start:dev --workspace @papercusp/sidestage-api",
    "dev:web": "npm run dev --workspace @papercusp/sidestage-web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:apply": "bash scripts/db-apply.sh",
    "test": "npm run test:apps",
    "test:apps": "npm run test --workspace @papercusp/sidestage-api && npm run test --workspace @papercusp/sidestage-web",
    "check": "npm run typecheck && npm test",
    "clean": "npm run clean --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.8.3",
    "vitest": "^4.1.4"
  }
}
