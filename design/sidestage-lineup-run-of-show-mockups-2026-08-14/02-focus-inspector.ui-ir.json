{
  "irVersion": "0.1",
  "surface": "SideStage Event Lineup — Focus inspector",
  "ecosystem": "react-tailwind",
  "layout": {
    "kind": "stack",
    "direction": "vertical",
    "children": [
      {
        "kind": "header",
        "children": [
          {
            "kind": "heading",
            "title": {
              "key": "inspector.title",
              "default": "Shape the arc, then tune the beat."
            }
          },
          {
            "kind": "text",
            "copy": {
              "key": "inspector.description",
              "default": "Reorder the scan-friendly rail. Edit only the selected product."
            }
          },
          {
            "kind": "stack",
            "direction": "horizontal",
            "children": [
              {
                "kind": "component",
                "ref": "inspector-reset"
              },
              {
                "kind": "component",
                "ref": "inspector-save"
              }
            ]
          }
        ]
      },
      {
        "kind": "grid",
        "responsive": {
          "viewport.mobile": {
            "kind": "stack",
            "direction": "vertical"
          }
        },
        "children": [
          {
            "kind": "stack",
            "direction": "vertical",
            "children": [
              {
                "kind": "heading",
                "title": {
                  "key": "inspector.order.title",
                  "default": "Show order"
                }
              },
              {
                "kind": "list",
                "binding": {
                  "slot": "plannedItems",
                  "repeats": true,
                  "shape": "RunOfShowItem"
                },
                "item": {
                  "kind": "card",
                  "children": [
                    {
                      "kind": "component",
                      "ref": "select-focused-product"
                    },
                    {
                      "kind": "text",
                      "copy": {
                        "key": "inspector.item.summary",
                        "default": "{duration} min · {notesStatus}"
                      },
                      "binding": {
                        "slot": "product.planSummary",
                        "shape": "string"
                      }
                    },
                    {
                      "kind": "stack",
                      "direction": "horizontal",
                      "children": [
                        {
                          "kind": "component",
                          "ref": "inspector-move-up"
                        },
                        {
                          "kind": "component",
                          "ref": "inspector-move-down"
                        }
                      ]
                    }
                  ]
                }
              },
              {
                "kind": "list",
                "binding": {
                  "slot": "reservedItems",
                  "repeats": true,
                  "shape": "ReservedProduct"
                },
                "item": {
                  "kind": "card",
                  "children": [
                    {
                      "kind": "heading",
                      "title": {
                        "key": "inspector.reserve.item",
                        "default": "{product.title}"
                      },
                      "binding": {
                        "slot": "product.title",
                        "shape": "string"
                      }
                    },
                    {
                      "kind": "component",
                      "ref": "inspector-add"
                    }
                  ]
                }
              }
            ]
          },
          {
            "kind": "card",
            "responsive": {
              "viewport.mobile": {
                "kind": "drawer"
              }
            },
            "children": [
              {
                "kind": "heading",
                "title": {
                  "key": "inspector.editor.title",
                  "default": "{selectedProduct.title}"
                },
                "binding": {
                  "slot": "selectedProduct.title",
                  "shape": "string"
                }
              },
              {
                "kind": "text",
                "copy": {
                  "key": "inspector.editor.commerce",
                  "default": "{price} · {stock} available · {sku}"
                },
                "binding": {
                  "slot": "selectedProduct.commerceSummary",
                  "shape": "string"
                }
              },
              {
                "kind": "input",
                "label": {
                  "key": "inspector.minutes.label",
                  "default": "Planned minutes"
                },
                "binding": {
                  "slot": "selectedProduct.durationMinutes",
                  "shape": "number"
                },
                "interactions": [
                  "update-duration"
                ],
                "a11y": {
                  "role": "spinbutton",
                  "ariaLabel": {
                    "key": "inspector.minutes.aria",
                    "default": "Planned minutes for the selected product"
                  }
                }
              },
              {
                "kind": "textarea",
                "label": {
                  "key": "inspector.notes.label",
                  "default": "On-stage notes"
                },
                "binding": {
                  "slot": "selectedProduct.notes",
                  "shape": "string"
                },
                "interactions": [
                  "update-notes"
                ],
                "a11y": {
                  "role": "textbox",
                  "ariaLabel": {
                    "key": "inspector.notes.aria",
                    "default": "On-stage notes for the selected product"
                  }
                }
              },
              {
                "kind": "banner",
                "title": {
                  "key": "inspector.preview.title",
                  "default": "Active Event preview"
                },
                "copy": {
                  "key": "inspector.preview.copy",
                  "default": "{selectedProduct.title} · {duration} minutes · {notes}"
                },
                "a11y": {
                  "role": "region",
                  "ariaLabel": {
                    "key": "inspector.preview.aria",
                    "default": "Selected product Active Event preview"
                  }
                }
              },
              {
                "kind": "stack",
                "direction": "horizontal",
                "children": [
                  {
                    "kind": "component",
                    "ref": "inspector-remove"
                  },
                  {
                    "kind": "component",
                    "ref": "inspector-save-details"
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "components": [
    {
      "id": "inspector-save",
      "registry": "action.primary",
      "props": {
        "label": "Save Lineup",
        "action": "save-draft"
      }
    },
    {
      "id": "inspector-reset",
      "registry": "action.secondary",
      "props": {
        "label": "Reset",
        "action": "reset-scenario"
      }
    },
    {
      "id": "select-focused-product",
      "registry": "control.select",
      "props": {
        "label": "Choose product to edit",
        "valueSlot": "selectedProductId"
      }
    },
    {
      "id": "inspector-move-up",
      "registry": "action.secondary",
      "props": {
        "label": "Move up",
        "action": "move-item-up"
      }
    },
    {
      "id": "inspector-move-down",
      "registry": "action.secondary",
      "props": {
        "label": "Move down",
        "action": "move-item-down"
      }
    },
    {
      "id": "inspector-add",
      "registry": "action.secondary",
      "props": {
        "label": "Add",
        "action": "add-to-plan"
      }
    },
    {
      "id": "inspector-remove",
      "registry": "action.secondary",
      "props": {
        "label": "Remove from plan",
        "action": "remove-from-plan"
      }
    },
    {
      "id": "inspector-save-details",
      "registry": "action.primary",
      "props": {
        "label": "Save details",
        "action": "save-selected-details"
      }
    }
  ],
  "states": {
    "loading": {
      "kind": "banner",
      "copy": {
        "key": "lineup.loading",
        "default": "Loading the event Lineup…"
      },
      "a11y": {
        "role": "status",
        "ariaLive": "polite"
      }
    },
    "error": {
      "kind": "banner",
      "copy": {
        "key": "lineup.error",
        "default": "The Lineup could not be loaded."
      },
      "interactions": [
        "retry"
      ],
      "a11y": {
        "role": "alert",
        "ariaLive": "assertive"
      }
    }
  },
  "a11y": {
    "landmark": "main",
    "headingLevel": 1
  }
}
